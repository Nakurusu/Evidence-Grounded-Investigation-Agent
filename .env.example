# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://appuser:password@localhost:5432/appdb

# ── LLM / Narrative Generation ────────────────────────────
# Provider mode: "mock" (no API needed) or "openai" (API key required)
LLM_MODE=mock

# Required when LLM_MODE=openai
LLM_API_KEY=your-api-key-here

# Optional — customize the API endpoint and model
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
