# ── Database ──────────────────────────────────────────────
# Docker Compose (default):
DATABASE_URL=postgresql://appuser:password@localhost:5432/appdb

# Local PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/investigative_analyst

# ── LLM / Narrative Generation ────────────────────────────
# Provider mode: "mock" (no API key needed) or "openai" (uses LLM)
LLM_MODE=mock

# Required when LLM_MODE=openai
LLM_API_KEY=your-api-key-here

# Optional — any OpenAI-compatible API works
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
